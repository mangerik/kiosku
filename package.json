{
  "name": "kiosku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:db": "node scripts/check-database.mjs",
    "typecheck": "tsc -b",
    "check:edge": "deno check --config supabase/deno.json supabase/functions/checkout/index.ts supabase/functions/payment-proof/index.ts supabase/functions/payment-webhook/index.ts supabase/functions/billing-checkout/index.ts supabase/functions/maintenance/index.ts",
    "format": "prettier --write src scripts supabase/functions package.json vite.config.ts",
    "test:edge": "deno test --config supabase/deno.json --allow-env supabase/functions/_shared"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "@phosphor-icons/react": "^2.1.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.1.0",
    "papaparse": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "deno": "^2.9.6",
    "fflate": "^0.8.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
